---
import { getEntry, render } from "astro:content";
import { Picture, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

// 假设你有这个业务数据，如果没有，可以在下面直接写死
// import { BUSINESS } from "@data/client";

// 检查页面是否启用
if (!siteConfig.pages.guestbook) {
	return Astro.redirect("/404/");
}

const guestbookPost = await getEntry("spec", "guestbook");
if (!guestbookPost) {
	throw new Error("guestbook page content not found");
}
const { Content } = await render(guestbookPost);

// 图片资源引入
import landingImage from "@assets/images/gallery/bannercontact.jpg";
import skyscraperImage from "@assets/images/gallery/skyscraper.jpg";
import factoryMapImage from "@assets/images/gallery/factory-map.jpg";
const optimizedImage = await getImage({ src: landingImage, format: "webp" });

// 页面标题和描述
const title = i18n(I18nKey.guestbook);
const description = i18n(I18nKey.guestbookDescription);

// 业务数据（请根据实际情况修改）
const BUSINESS = {
	// 👇 修改点1：邮箱改成了 info@
	email: "info@allbambooflooring.com", 
	address: {
		lineOne: "Economic Development Zone",
		lineTwo: "Guangde City",
		city: "Xuancheng",
		state: "Anhui",
		zip: "242200",
		mapLink: "https://maps.google.com"
	}
};
---

<MainGridLayout title={title} description={description}>
  <div class="flex flex-col w-full gap-4">
    
    <!-- 1. 页面标题与介绍 (Markdown 内容) -->
    <div class="card-base z-10 px-6 py-8 md:px-9 relative w-full overflow-hidden">
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-3">
          <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
            <Icon is:inline name="material-symbols:chat" class="text-[1.5rem]"></Icon>
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
        </div>
        {description && (
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            {description}
          </p>
        )}
      </div>
      <div class="prose dark:prose-invert max-w-none text-neutral-600 dark:text-neutral-300">
        <Content />
      </div>
    </div>

    <!-- 2. 询盘表单与联系方式区域 -->
    <section id="cs-contact" class="w-full relative">
      <div class="cs-container">
        <form
          id="cs-form"
          name="Contact Form"
          action="https://forminit.com/f/5jndokb8gr1"
          method="POST"
          class="cs-form-wrapper"
        >
          <label>
            Name
            <input required type="text" id="name" name="fi-sender-fullName" placeholder="Your Name" />
          </label>
          <label>
            Email
            <input required type="email" id="email" name="fi-sender-email" placeholder="Your Email" />
          </label>
          <label>
            Phone / WhatsApp
            <input type="text" id="phone" name="fi-text-phone" placeholder="+1 (555) 000-0000" />
          </label>
          <label>
            Product Interest
            <input type="text" id="find" name="fi-text-findUs" placeholder="e.g. Strand Woven Flooring" />
          </label>
          <label class="cs-label-message">
            Message
            <textarea required name="fi-text-message" id="message" placeholder="Please provide details like quantity, thickness, and destination port..."></textarea>
          </label>
          <button class="cs-button-solid" type="submit">Submit Inquiry</button>
        </form>

        <div class="cs-right-section">
          <!--Email-->
          <span class="cs-header">Email</span>
          <a class="cs-link" href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
          
          <!--Phone-->
          <span class="cs-header">Phone</span>
          <a class="cs-link" href="tel:+865633032211">+86 (563) 303-2211</a>
          
          <!--WhatsApp-->
          <span class="cs-header">WhatsApp</span>
          <a class="cs-link" href="https://wa.me/8615005820528" target="_blank" rel="nofollow noopener noreferrer">+86 150 0582 0528</a>
          
          <!--Address-->
          <span class="cs-header">Address</span>
          <a class="cs-link" href={BUSINESS.address.mapLink} target="_blank" rel="noopener">
            {BUSINESS.address.lineOne},<br />
            {BUSINESS.address.lineTwo},<br />
            <span class="cs-block">
              {BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip}
            </span>
          </a>

          <!-- Background Image-->
          <Picture
            src={skyscraperImage}
            alt="building"
            width={2500}
            height={1667}
            formats={["avif", "webp"]}
            pictureAttributes={{ class: "cs-bg-picture" }}
          />
        </div>
      </div>
    </section>

    <!-- 3. 地理位置与物流信息 -->
    <section id="cs-location" class="w-full relative mt-4">
      <div class="cs-location-container">
        <div class="cs-location-header">
          <span class="cs-topper">Location</span>
          <h2 class="cs-title">Our Global Presence</h2>
        </div>

        <div class="cs-location-content">
          <div class="cs-map-wrapper">
            <a href={factoryMapImage.src} target="_blank" rel="noopener noreferrer" class="cs-map-link" aria-label="View full size map image">
              <Picture
                src={factoryMapImage}
                alt="Bothbest Bamboo Factory Location Map"
                widths={[400, 800, 1280]}
                sizes="(max-width: 1280px) 100vw, 1280px"
                formats={["avif", "webp"]}
                pictureAttributes={{ class: "cs-map-picture" }}
              />
              <div class="cs-map-overlay">
                <span class="cs-map-badge">Factory Location</span>
                <p class="cs-map-address">
                  {BUSINESS.address.lineOne}, {BUSINESS.address.city}
                </p>
                <span class="cs-map-btn">Click to View Map ↗</span>
              </div>
            </a>
          </div>

          <div class="cs-info-wrapper">
            <div class="cs-info-card">
              <div class="cs-icon-wrapper">
                <svg class="cs-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22 16v-2l-8.5-5V3.5C13.5 2.67 12.83 2 12 2s-1.5.67-1.5 1.5V9L2 14v2l8.5-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13.5 19v-5.5L22 16z"></path>
                </svg>
              </div>
              <div class="cs-info-text">
                <h3 class="cs-info-title">Factory Visits & Airport Access</h3>
                <p class="cs-info-desc">
                  Planning to visit our bamboo manufacturing facility? The most convenient airport is <strong>Hangzhou Xiaoshan International Airport (HGH)</strong>, located approximately 80 km (a 1-hour drive) from our factory. We can arrange airport pick-up services upon request.
                </p>
              </div>
            </div>

            <div class="cs-info-card">
              <div class="cs-icon-wrapper">
                <svg class="cs-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20 21c-1.39 0-2.78-.47-4-1.32-2.44 1.71-5.56 1.71-8 0C6.78 20.53 5.39 21 4 21H2v2h2c1.38 0 2.74-.35 4-.99 2.52 1.29 5.48 1.29 8 0 1.26.64 2.62.99 4 .99h2v-2h-2zM3.95 12l.71-2h14.68l.71 2H3.95zm16.05 2H4c-1.1 0-2 .9-2 2v2c1.39 0 2.78-.47 4-1.32 2.44 1.71 5.56 1.71-8 0 1.22.85 2.61 1.32 4 1.32h12v-2c0-1.1-.9-2-2-2zM13 4h-2v3H8l4 4 4-4h-3V4z"></path>
                </svg>
              </div>
              <div class="cs-info-text">
                <h3 class="cs-info-title">Global Shipping & Logistics</h3>
                <p class="cs-info-desc">
                  Our factory is strategically located with convenient port access. We typically export and ship ocean freight from <strong>Shanghai Port</strong> (approx. 230 km away), which offers the most efficient routes, frequent vessel schedules, and competitive shipping rates.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</MainGridLayout>

<style>
	/* PAGE-SPECIFIC STYLES FOR THE CONTACT PAGE */
	
	// 基础变量设定，确保和 Firefly 主题融合
	#cs-contact, #cs-location {
		--primary: var(--hue-color, #22c55e); /* 使用主题绿 */
		--headerColor: var(--text-90, #111827);
		--bodyTextColor: var(--text-75, #374151);
		--bodyTextColorWhite: #ffffff;
		--sectionPadding: 2rem 1rem;
	}

	/*-- -------------------------- -->
	<---          Contact           -->
	<--- -------------------------- -*/

	/* Mobile - 360px */
	@media only screen and (min-width: 0em) {
		#cs-contact {
			padding: 1.5rem 0;

			.cs-container {
				width: 100%;
				max-width: 80rem;
				margin: auto;
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			.cs-content { width: 100%; }

			.cs-topper {
				text-align: left;
				margin-bottom: 0.5rem;
				color: var(--primary);
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				font-size: 0.875rem;
			}

			.cs-title {
				text-align: left;
				max-width: 50rem;
				font-size: 2rem;
				font-weight: 700;
				color: var(--headerColor);
				margin-bottom: 1rem;
			}

			.cs-text {
				text-align: left;
				max-width: 40rem;
				margin: 0 0 2rem 0;
				color: var(--bodyTextColor);
				line-height: 1.6;
			}

			#cs-form {
				margin-bottom: 2rem;
				display: flex;
				flex-direction: column;
			}
			
			#cs-form label {
				font-size: 1rem;
				font-weight: 700;
				line-height: 1.5em;
				margin-bottom: 1.25rem;
				color: var(--headerColor);
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: flex-start;
			}

			#cs-form .cs-label-message { margin-bottom: 2rem; }

			#cs-form input,
			#cs-form textarea {
				font-size: 1rem;
				width: 100%;
				height: 4rem;
				margin-top: 0.25rem;
				box-sizing: border-box;
				padding-left: 1.25rem;
				border: 1px solid rgba(150, 150, 150, 0.3);
				background-color: transparent;
				border-radius: 0.5rem;
				transition: border 0.3s;
				color: var(--headerColor);
			}

			#cs-form input:hover,
			#cs-form textarea:hover { border: 1px solid var(--primary); }
			#cs-form input:focus,
			#cs-form textarea:focus { outline: none; border: 1px solid var(--primary); }

			#cs-form textarea {
				font-family: inherit;
				min-height: 8rem;
				padding-top: 1.25rem;
			}

			#cs-form .cs-button-solid {
				width: 100%;
				border: none;
				background-color: var(--primary);
				color: #fff;
				padding: 1rem;
				border-radius: 0.5rem;
				font-weight: 700;
				font-size: 1rem;
				cursor: pointer;
				transition: opacity 0.3s;
			}
			#cs-form .cs-button-solid:hover { opacity: 0.9; }

			.cs-right-section {
				height: 20rem;
				padding: 1.5rem;
				border-radius: 0.5rem;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				align-items: flex-start;
				position: relative;
				overflow: hidden;
				box-shadow: 0 10px 30px rgba(0,0,0,0.1);
			}

			.cs-header {
				font-size: 1rem;
				font-weight: 700;
				margin-bottom: 0.5rem;
				color: rgba(255,255,255,0.7);
				display: block;
			}

			.cs-link {
				font-size: 1.1rem;
				line-height: 1.4em;
				text-decoration: none;
				margin-bottom: 1.25rem;
				color: var(--bodyTextColorWhite);
				display: block;
				position: relative;
				z-index: 2;
				font-weight: 500;
			}

			.cs-link:hover { text-decoration: underline; }
			.cs-link:last-of-type { margin-bottom: 0; }

			.cs-block { display: block; }

			.cs-bg-picture {
				width: 100%;
				height: 100%;
				display: block;
				position: absolute;
				top: 0;
				left: 0;
				z-index: 0;
				transition: transform 0.6s;
			}

			.cs-bg-picture::before {
				content: "";
				width: 100%;
				height: 100%;
				background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.8) 100%);
				display: block;
				position: absolute;
				top: 0;
				left: 0;
				z-index: 1;
			}

			.cs-bg-picture img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				position: absolute;
				top: 0;
				left: 0;
			}
		}
	}

	/* Tablet - 700px */
	@media only screen and (min-width: 43.75em) {
		#cs-contact #cs-form {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
			flex-wrap: wrap;
		}
		#cs-contact #cs-form label { width: 48%; }
		#cs-contact #cs-form .cs-label-message { width: 100%; }
	}

	/* Small Desktop - 1024px */
	@media only screen and (min-width: 64em) {
		#cs-contact .cs-container {
			display: flex;
			flex-direction: row;
			justify-content: flex-end;
			align-items: stretch;
			gap: 3rem;
		}

		#cs-contact #cs-form {
			width: 60%;
		}
		#cs-contact #cs-form label { width: 100%; }

		#cs-contact .cs-right-section {
			width: 40%;
			flex: none;
			height: auto;
		}
		#cs-contact .cs-right-section:hover .cs-bg-picture { transform: scale(1.05); }

		#cs-contact .cs-block { display: inline-block; }
	}

	/* Small Desktop - 1300px */
	@media only screen and (min-width: 81.25em) {
		#cs-contact #cs-form {
			flex-direction: row;
		}
		#cs-contact #cs-form label {
			width: 48%;
		}
		#cs-contact #cs-form .cs-label-message { width: 100%; }
	}

	/*-- -------------------------- -->
	<---     Location & Map Section -->
	<--- -------------------------- -*/

	/* Mobile - 360px */
	@media only screen and (min-width: 0em) {
		#cs-location {
			padding: 2rem 0;
		}

		#cs-location .cs-location-container {
			width: 100%;
			max-width: 80rem;
			margin: auto;
		}

		#cs-location .cs-location-header {
			text-align: center;
			margin-bottom: 2rem;
		}

		#cs-location .cs-location-header .cs-topper {
			display: block;
			margin-bottom: 0.5rem;
			color: var(--primary);
			font-weight: 700;
			text-transform: uppercase;
		}

		#cs-location .cs-location-header .cs-title { margin: 0; font-size: 2rem; font-weight: 700; color: var(--headerColor); }

		#cs-location .cs-location-content {
			display: flex;
			flex-direction: column;
			gap: 2rem;
		}

		#cs-location .cs-map-wrapper { width: 100%; }

		#cs-location .cs-map-link {
			display: block;
			width: 100%;
			height: auto;
			aspect-ratio: 1278 / 832; 
			border-radius: 0.75rem;
			overflow: hidden;
			position: relative;
			box-shadow: rgba(149, 157, 165, 0.15) 0px 8px 24px;
			text-decoration: none;
		}

		#cs-location .cs-map-link:hover .cs-map-picture img { transform: scale(1.02); }
		#cs-location .cs-map-link:hover .cs-map-btn { background-color: var(--primary); color: #fff; }

		#cs-location .cs-map-picture {
			width: 100%;
			height: 100%;
			display: block;
		}

		#cs-location .cs-map-picture img {
			width: 100%;
			height: 100%;
			object-fit: cover; 
			display: block;
			transition: transform 0.5s ease;
		}

		#cs-location .cs-map-overlay {
			position: absolute;
			bottom: 1rem;
			right: 1.5rem;
			z-index: 2;
			background: rgba(255, 255, 255, 0.92);
			backdrop-filter: blur(8px);
			padding: 0.75rem 1rem;
			border-radius: 0.5rem;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
			max-width: 18rem;
			transition: background-color 0.3s;
		}

		#cs-location .cs-map-badge {
			font-size: 0.75rem;
			font-weight: 700;
			text-transform: uppercase;
			color: var(--primary);
			display: block;
			margin-bottom: 0.25rem;
		}

		#cs-location .cs-map-address {
			font-size: 0.875rem;
			font-weight: 600;
			color: #111;
			margin: 0 0 0.75rem 0;
			line-height: 1.3em;
		}

		#cs-location .cs-map-btn {
			display: inline-block;
			font-size: 0.8rem;
			font-weight: 700;
			color: #111;
			padding: 0.4rem 0.75rem;
			border: 1px solid var(--primary);
			border-radius: 0.25rem;
			transition: background-color 0.3s, color 0.3s;
		}

		#cs-location .cs-info-wrapper {
			width: 100%;
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			justify-content: center;
		}

		#cs-location .cs-info-card {
			display: flex;
			gap: 1rem;
			padding: 1.5rem;
			background-color: var(--btn-plain-bg);
			border-radius: 0.75rem;
			border: 1px solid var(--line-divider);
			transition: transform 0.3s, box-shadow 0.3s;
		}

		#cs-location .cs-info-card:hover {
			transform: translateY(-2px);
			box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
		}

		#cs-location .cs-icon-wrapper {
			width: 3rem;
			height: 3rem;
			background-color: rgba(0, 0, 0, 0.04);
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
		}

		#cs-location .cs-icon {
			width: 1.5rem;
			height: 1.5rem;
			fill: var(--primary);
		}

		#cs-location .cs-info-title {
			font-size: 1.125rem;
			font-weight: 700;
			color: var(--headerColor);
			margin: 0 0 0.5rem 0;
		}

		#cs-location .cs-info-desc {
			font-size: 0.95rem;
			line-height: 1.5em;
			color: var(--bodyTextColor);
			margin: 0;
		}
		#cs-location .cs-info-desc strong { color: var(--headerColor); }
	}

	/* Tablet & Desktop - 1024px 以上 */
	@media only screen and (min-width: 64em) {
		#cs-location .cs-location-content {
			flex-direction: row;
			align-items: stretch;
			gap: 2.5rem;
		}

		#cs-location .cs-map-wrapper {
			width: 55%;
			flex-shrink: 0;
		}

		#cs-location .cs-map-link { height: 100%; }
		#cs-location .cs-map-overlay { bottom: 1.25rem; right: 1.5rem; max-width: 18rem; padding: 1rem; }

		#cs-location .cs-info-wrapper { width: 45%; }
		#cs-location .cs-info-card { padding: 1.75rem; }
	}

	/* ==========================================================================
       🌟 暗黑模式适配 (匹配 Firefly 的 .dark 选择器)
       ========================================================================== */
	:global(html.dark) #cs-contact {
		--headerColor: #f3f4f6;
		--bodyTextColor: #d1d5db;
	}

	:global(html.dark) #cs-contact input, 
	:global(html.dark) #cs-contact textarea {
		background-color: rgba(255, 255, 255, 0.05);
		border-color: rgba(255, 255, 255, 0.1);
		color: #fff !important;
	}

	:global(html.dark) #cs-location {
		--headerColor: #f3f4f6;
		--bodyTextColor: #d1d5db;
	}

	:global(html.dark) #cs-location .cs-map-overlay {
		background: rgba(30, 30, 30, 0.95) !important;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	:global(html.dark) #cs-location .cs-map-overlay .cs-map-address, 
	:global(html.dark) #cs-location .cs-map-overlay .cs-map-btn {
		color: #fff !important;
	}

	:global(html.dark) #cs-location .cs-info-card {
		background-color: rgba(255, 255, 255, 0.03) !important;
	}

	:global(html.dark) #cs-location .cs-info-card .cs-icon-wrapper { 
		background-color: rgba(255, 255, 255, 0.08); 
	}
</style>