---
import { getCollection } from 'astro:content';
import MainGridLayout from '@layouts/MainGridLayout.astro';
import PostCard from '@/components/layout/PostCard.astro'; // 引入你提供的文章卡片组件
import { getPostUrlBySlug } from '@/utils/url-utils';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts'); 
  
  const allCategories = [...new Set(allPosts.flatMap(post => 
    post.data.category ? (Array.isArray(post.data.category) ? post.data.category : [post.data.category]) : []
  ))];

  return allCategories.map((category) => {
    const slug = category.replace(/\s+/g, "-").toLowerCase();
    return {
      params: { category: slug },
      props: { originalCategory: category },
    };
  });
}

const { originalCategory } = Astro.props;

const allPosts = await getCollection('posts'); 
const filteredPosts = allPosts.filter(post => {
  if (!post.data.category) return false;
  const categories = Array.isArray(post.data.category) ? post.data.category : [post.data.category];
  return categories.includes(originalCategory);
});
---

<MainGridLayout title={`分类: ${originalCategory}`}>
  <div class="container mx-auto px-4 py-8">
    <!-- 顶部标题区域 -->
    <div class="mb-8 p-6 rounded-2xl bg-white/70 dark:bg-black/50 backdrop-blur-md">
      <h1 class="text-2xl font-bold text-[--primary]">分类: {originalCategory}</h1>
      <p class="text-sm mt-2 opacity-70">共找到 {filteredPosts.length} 篇文章</p>
    </div>
    
    <!-- 文章列表区域 -->
    <!-- 注意：如果需要网格或列表布局，可以在父级加上 class="grid-mode" 或 "list-mode" -->
    <div class="grid grid-cols-1 gap-6">
      {filteredPosts.map((post) => (
        <PostCard
          entry={post}
          title={post.data.title}
          url={getPostUrlBySlug(post.id)}
          published={post.data.published}
          updated={post.data.updated}
          tags={post.data.tags || []}
          category={post.data.category || null}
          image={post.data.image || ""}
          description={post.data.description || ""}
          draft={post.data.draft || false}
          pinned={post.data.pinned}
          password={post.data.password}
          style=""
        />
      ))}
    </div>
  </div>
</MainGridLayout>