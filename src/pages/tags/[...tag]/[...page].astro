---
import type { GetStaticPaths } from "astro";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getCollection("posts", ({ data }) => {
		return import.meta.env.PROD ? data.draft !== true : true;
	});

	// 提取所有标签并去重（忽略大小写）
	const uniqueTags = new Map<string, string>();
	allBlogPosts.forEach(post => {
		post.data.tags?.forEach(tag => {
			const original = tag.trim();
			const lower = original.toLowerCase();
			if (!uniqueTags.has(lower)) {
				uniqueTags.set(lower, original);
			}
		});
	});
	const allTags = Array.from(uniqueTags.entries());

	return allTags.flatMap(([lowerTag, originalTag]) => {
		// 过滤（忽略大小写）
		const filteredPosts = allBlogPosts.filter(post => 
			post.data.tags?.some(t => t.trim().toLowerCase() === lowerTag)
		);

		// 严格排序：置顶优先，然后时间倒序
		filteredPosts.sort((a, b) => {
			if (a.data.pinned && !b.data.pinned) return -1;
			if (!a.data.pinned && b.data.pinned) return 1;
			const dateA = new Date(a.data.published).getTime();
			const dateB = new Date(b.data.published).getTime();
			return dateB - dateA;
		});

		const pageSize = siteConfig.pagination.postsPerPage;
		return paginate(filteredPosts, {
			params: { tag: originalTag },
			props: { tag: originalTag },
			pageSize,
		});
	});
}) satisfies GetStaticPaths;

const { page, tag } = Astro.props;
const len = page.data.length;
---

<MainGridLayout title={`Tag: ${tag}`}>
  <div class="card-base px-6 py-4 mb-4">
    <h1 class="text-2xl font-bold">Tag: {tag}</h1>
    <p class="text-sm text-gray-500 mt-1">Found {page.total} posts</p>
  </div>

  <PostPage page={page} />
  
  {
    page.total > page.size && (
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
      />
    )
  }
</MainGridLayout>