---
import type { GetStaticPaths } from "astro";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
// 👇 直接引入主题自带的排序函数，保证和首页一模一样
import { getSortedPosts } from "@/utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	// 1. 获取已经完美排序好（置顶优先 > 时间倒序）的所有文章
	const allBlogPosts = await getSortedPosts();
	
	// 2. 提取所有分类并去重（忽略大小写）
	const uniqueCategories = new Map<string, string>();
	allBlogPosts.forEach(post => {
		if (post.data.category) {
			const original = post.data.category.trim();
			const lower = original.toLowerCase();
			if (!uniqueCategories.has(lower)) {
				uniqueCategories.set(lower, original);
			}
		}
	});
	const allCategories = Array.from(uniqueCategories.entries()); 

	// 3. 为每个分类生成分页页面
	return allCategories.flatMap(([lowerCat, originalCat]) => {
		// 4. 从排好序的列表中过滤出当前分类的文章（自然保持原有顺序）
		const filteredPosts = allBlogPosts.filter(post => 
			post.data.category?.trim().toLowerCase() === lowerCat
		);

		const pageSize = siteConfig.pagination.postsPerPage;
		return paginate(filteredPosts, {
			params: { category: originalCat },
			props: { category: originalCat },
			pageSize,
		});
	});
}) satisfies GetStaticPaths;

const { page, category } = Astro.props;
const len = page.data.length;
---

<MainGridLayout title={`Category: ${category}`}>
  <div class="card-base px-6 py-4 mb-4">
    <h1 class="text-2xl font-bold">Category: {category}</h1>
    <p class="text-sm text-gray-500 mt-1">Found {page.total} posts</p>
  </div>
  
  <PostPage page={page} />
  
  {
    page.total > page.size && (
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
      />
    )
  }
</MainGridLayout>